# ─── MongoDB ────────────────────────────────────────────────
# Full connection string from MongoDB Atlas (or local mongod)
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/sunrise_school?retryWrites=true&w=majority

# ─── JWT ────────────────────────────────────────────────────
# Long random string – used to sign every token.  Generate one:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# How long a token stays valid (ms, s, m, h, d — any value ms understands)
JWT_EXPIRES_IN=7d

# ─── Server ─────────────────────────────────────────────────
# Port the Express server listens on (Render overrides with its own PORT)
PORT=5000

# ─── CORS ───────────────────────────────────────────────────
# Your frontend URL (no trailing slash)
FRONTEND_ORIGIN=https://sunriseinternationalschool.netlify.app

# ─── Admin seed ─────────────────────────────────────────────
# These are used ONCE on first boot to create the initial admin account.
# Change the password immediately after first login.
ADMIN_EMAIL=admin@sunrise.edu
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=School Administrator
